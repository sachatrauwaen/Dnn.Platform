<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Target Name="AfterBuild" DependsOnTargets="GetFiles;DebugProject;Package">
    </Target>
    <Target Name="GetFiles">
        <ItemGroup>
            <ContainerFiles Include="Container\**\*.*" />
            <SkinFiles Include="Skin\**\*.*" />
        </ItemGroup>
    </Target>
    <Target Name="DebugProject" Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <Copy
            SourceFiles="@(ContainerFiles)"
            DestinationFiles="@(ContainerFiles->'$(SkinFolderName)\Containers\$(SkinName)\%(RecursiveDir)%(Filename)%(Extension)')" />
        <Copy
            SourceFiles="@(SkinFiles)"
            DestinationFiles="@(SkinFiles->'$(SkinFolderName)\Skins\$(SkinName)\%(RecursiveDir)%(Filename)%(Extension)')" />
    </Target>
</Project>